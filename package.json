{
  "name": "b-side",
  "productName": "Groove",
  "version": "1.6.1",
  "description": "Groove music player",
  "author": "AliAliAljasim",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "./build-config.sh && electron .",
    "dist:win": "./build-config.sh && electron-builder --win --x64",
    "release:win": "bash scripts/release.sh"
  },
  "build": {
    "appId": "com.alialialjasim.bside",
    "productName": "Groove",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "youtube.js",
      "config.js",
      "oauth.json",
      "style.css",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "menu.html",
      "menu-preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "b-side",
      "signAndEditExecutable": false
    },
    "afterPack": "scripts/after-pack.js",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Groove",
      "uninstallDisplayName": "Groove",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "groove-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AliAliAljasim",
        "repo": "music-player",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
